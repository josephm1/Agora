<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" path="secrets.xml" />
        <exclude domain="sharedpref" path="secrets.xml.bak" />
        <exclude domain="sharedpref" path="chatgpt-state.xml" />
        <exclude domain="sharedpref" path="chatgpt-state.xml.bak" />
        <exclude domain="sharedpref" path="chatgpt-billing.xml" />
